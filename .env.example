# Server
PORT=8080
HOST=0.0.0.0
DATABASE_PATH=./data/dispatch.db
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:8080

# Code a user must enter to sign in as a dispatcher (control room). Empty = open (dev only).
DISPATCHER_CODE=change-me

# Matching
OFFER_TIMEOUT_SECONDS=20      # how long a unit has to accept before the next unit is asked
OFFER_FANOUT=3                # how many nearest units are asked at once (1 = strictly sequential)
MAX_RADIUS_KM=30              # only units within this distance are considered
SEARCH_TIMEOUT_SECONDS=300    # mark the request unfulfilled (dispatcher attention) after this
LOCATION_STALE_SECONDS=300    # ignore units whose last GPS fix is older than this
AVERAGE_SPEED_KMH=45          # used for ETA estimates

# Cloud / integrations
TRUST_PROXY=true                      # behind Render/Fly/Cloud Run/nginx
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=dispatch-app (you@example.com)   # OpenStreetMap requires a contact
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_MAX_ATTEMPTS=3

# Sign-in security (turn on for any public deployment)
OTP_REQUIRED=false                    # true = SMS one-time code at sign-in
OTP_TTL_SECONDS=300
SMS_PROVIDER=log                      # log | twilio | http
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_HTTP_URL=                         # generic JSON gateway, e.g. https://api.yourgateway/send
SMS_HTTP_HEADERS={"Authorization":"Bearer <token>"}
SMS_HTTP_BODY={"to":"{to}","message":"{text}"}

# Push notifications (generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Backups (copies of the SQLite file next to it in /backups)
BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=
BACKUP_KEEP=14
