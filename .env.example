# Server
PORT=8080
HOST=0.0.0.0
DATABASE_PATH=./data/dispatch.db
LOG_LEVEL=info

# Operator console / API authentication.
# Every request from the console must carry `x-api-key: <OPERATOR_API_KEY>`.
# Leave empty to disable auth (local development only).
OPERATOR_API_KEY=change-me-operator-key

# Inbound alert sources. Each source has its own shared secret.
# DeepAlert must POST to  https://<host>/api/webhooks/deepalert  with header
#   x-webhook-secret: <WEBHOOK_SECRET_DEEPALERT>      (or ?token=... query param)
WEBHOOK_SECRET_DEEPALERT=change-me-deepalert-secret
WEBHOOK_SECRET_GENERIC=change-me-generic-secret

# Outbound: secret used to HMAC-sign dispatch webhooks sent to responders
# (header x-dispatch-signature: sha256=<hex>).
DISPATCH_SIGNING_SECRET=change-me-dispatch-signing-secret

# Public base URL used to build responder callback links.
PUBLIC_BASE_URL=http://localhost:8080

# Optional: auto-dismiss alerts with confidence below this (0-1). Empty = keep all.
MIN_CONFIDENCE=
